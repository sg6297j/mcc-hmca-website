rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email.lower() == 'sg6297j@gmail.com'; }
    function meRef() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function approved() { return signedIn() && exists(meRef()) && get(meRef()).data.status == 'approved'; }
    function isMentor() { return approved() && get(meRef()).data.role == 'mentor'; }
    function assignedTo(mid) {
      return exists(/databases/$(database)/documents/mentees/$(mid)) &&
        request.auth.uid in get(/databases/$(database)/documents/mentees/$(mid)).data.mentors;
    }

    match /users/{uid} {
      allow read: if approved() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && ((request.resource.data.status == 'pending' && request.resource.data.lead == false)
            || (isAdmin() && request.resource.data.lead == true));
      allow update, delete: if isAdmin();
    }
    match /mentees/{mid} {
      allow read: if approved();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isMentor() && request.auth.uid in resource.data.mentors && request.resource.data.mentors == resource.data.mentors)
        || (approved() && request.auth.uid == mid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['topics']));
    }
    match /progress/{mid} {
      allow read: if approved();
      allow write: if isAdmin() || (approved() && request.auth.uid == mid) || (isMentor() && assignedTo(mid));
    }
    match /materials/{id} { allow read: if approved(); allow write: if isMentor(); }
    match /files/{id} { allow read: if approved(); allow write: if isMentor(); }
    match /announcements/{id} { allow read: if true; allow write: if isMentor(); }
  }
}
